# PostgreSQL (Railway injeta DATABASE_URL automaticamente ao vincular o plugin Postgres)
DATABASE_URL=postgres://localhost:5432/feeling_aprovacao
# Segredo do JWT (gere com: openssl rand -hex 32)
JWT_SECRET=troque-este-segredo
# Porta HTTP (Railway injeta PORT)
PORT=3001
# URL pública da API (Railway), usada para montar as URLs dos arquivos
API_URL=http://localhost:3001
# URL pública do front (Vercel), usada no link enviado ao cliente e no CORS
FRONTEND_URL=http://localhost:5173
# Pasta dos uploads (no Railway, monte um volume em /data)
STORAGE_PATH=./uploads
# Tamanho máximo por arquivo em MB
MAX_UPLOAD_MB=200
# Horário do job de auto-aprovação (cron, fuso America/Sao_Paulo)
AUTO_APPROVE_CRON=0 9 * * *
# Seed: senha do admin inicial
ADMIN_EMAIL=admin@feeling.com.br
ADMIN_PASSWORD=feeling123
